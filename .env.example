# ═══════════════════════════════════════════════════════════════════
# Burç Agent - Environment Variables
# Bu dosyayı .env olarak kopyala ve değerleri kendi anahtarlarınla doldur.
# Railway'de bunları Settings → Variables bölümüne girersin.
# ═══════════════════════════════════════════════════════════════════

# ─── LLM (İçerik Üretimi) ──────────────────────────────────────────
# En az biri zorunlu. Ama yedek olsun diye üçünü de ekle.
ANTHROPIC_API_KEY=sk-ant-api03-...
GEMINI_API_KEY=AIzaSy...
GROQ_API_KEY=gsk_...

# Opsiyonel: Claude model seçimi (varsayılan: claude-haiku-4-5)
# CLAUDE_MODEL=claude-haiku-4-5

# Opsiyonel: yedek model adları (virgülle, sırayla denenir). Listedeki
# modellerin hepsi kaldırılmışsa kod sağlayıcının güncel listesinden
# otomatik seçer; bu değişkenler sadece elle sabitlemek için.
# GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite
# GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b

# ─── Görsel Servisleri ─────────────────────────────────────────────
# İkisinden de alabilirsin, daha iyi görsel havuzu için önerilir.
PIXABAY_API_KEY=12345678-abcdef...
PEXELS_API_KEY=abcdef1234567890...

# ─── TTS (Opsiyonel) ───────────────────────────────────────────────
# Yoksa Edge TTS veya gTTS kullanılır (ücretsiz).
# ELEVENLABS_API_KEY=sk_...
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM  # Rachel (kadın anlatıcı)

# ─── Telegram ──────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=1234567890:ABCdef...
TELEGRAM_CHAT_ID=987654321

# ─── YouTube (OAuth credentials) ───────────────────────────────────
# Lokal geliştirmede credentials_burc.json ve token_burc.json
# dosyalarını proje kök klasörüne koy.
# Railway'de ise bu dosyaları base64 ile env variable olarak gir.
# Terminal komutu (lokal olarak çalıştır):
#   python -c "import base64; print(base64.b64encode(open('credentials_burc.json','rb').read()).decode())"
# Çıkan değeri CREDENTIALS_BURC'e ata.
# Aynısını token_burc.json için yap, TOKEN_BURC'e ata.
# CREDENTIALS_BURC=eyJpbnN0YWxsZWQiOi...
# TOKEN_BURC=eyJ0b2tlbiI6Ii4uLiJ9...

# ─── Scheduler ─────────────────────────────────────────────────────
# Her gün bu saatte 12 burç otomatik üretilir (sunucu saatine göre)
BURC_BATCH_TIME=06:00
TIMEZONE=Europe/Istanbul

# ─── Arka Plan Servisleri (gelişmiş) ───────────────────────────────
# 0 yazarsan kapanır (mesela sadece test için web paneli çalışsın)
# START_TELEGRAM=1
# START_SCHEDULER=1

# ─── Güvenlik ──────────────────────────────────────────────────────
# Web paneli şifresi. Tanımlı değilse panel HERKESE AÇIKTIR.
# Tarayıcı kullanıcı adı/şifre sorar (kullanıcı adı: PANEL_USER).
PANEL_PASSWORD=
# PANEL_USER=admin
# /api/admin/* test endpoint'leri için ?key= değeri. Boşsa bu
# endpoint'ler kapalıdır.
# ADMIN_KEY=
